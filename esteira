// =====================================
// SETUP
// =====================================
void setup() {
  // Inicializa o motor desligado
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);

  desligarMotor();

  Serial.begin(9600);

  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

  digitalWrite(TRIG, LOW);

  // Cria rede Wi-Fi
  WiFi.mode(WIFI_AP);
  WiFi.softAP(ssid, senha);

  // Rotas web
  servidor.on(
    "/",
    HTTP_GET,
    paginaInicial
  );

  servidor.on(
    "/dados",
    HTTP_GET,
    enviarDados
  );

  servidor.on(
    "/ligar",
    HTTP_POST,
    ligarMotor
  );

  servidor.on(
    "/desligar",
    HTTP_POST,
    comandoDesligar
  );

  servidor.on(
    "/zerar",
    HTTP_POST,
    zerarContador
  );

  servidor.begin();

  Serial.println();
  Serial.println("ESTEIRA INTELIGENTE");
  Serial.println("Wi-Fi iniciado!");

  Serial.print("IP: ");
  Serial.println(WiFi.softAPIP());
}

// =====================================
// LOOP
// =====================================
void loop() {
  servidor.handleClient();

  atualizarContador();

  yield();
}
