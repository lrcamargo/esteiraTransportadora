
#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

// =====================================
// WIFI DA ESTEIRA
// =====================================
const char* ssid = "Esteira_SENAI";
const char* senha = "esteira123";

ESP8266WebServer servidor(80);

// =====================================
// PINOS DA D1 WIFI
// =====================================
const int TRIG = 14;
const int ECHO = 12;

const int IN1 = 5;
const int IN2 = 4;

// =====================================
// CONFIGURACOES
// =====================================

// Deixe false enquanto o L298N
// estiver superaquecendo.
const bool MOTOR_HABILITADO = true;

// Distancias do ultrassonico
const float LIMITE_ENTRADA = 10.0;
const float LIMITE_SAIDA = 15.0;

// Confirmacao por leituras validas
const int CONFIRMA_ENTRADA = 1;
const int CONFIRMA_SAIDA = 2;

// =====================================
// VARIAVEIS
// =====================================
unsigned long contador = 0;

float distancia = -1;

bool motorLigado = false;

// Inicia bloqueado ate detectar
// que nao existe objeto no sensor
bool objetoPresente = true;

int leiturasEntrada = 0;
int leiturasSaida = 0;

unsigned long ultimaLeitura = 0;

// =====================================
// MOTOR
// =====================================
void desligarMotor() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);

  motorLigado = false;
}

void ligarMotor() {
  if (!MOTOR_HABILITADO) {
    servidor.send(
      403,
      "text/plain",
      "Motor bloqueado por seguranca"
    );
    return;
  }

  digitalWrite(IN2, LOW);
  digitalWrite(IN1, HIGH);

  motorLigado = true;

  servidor.send(200, "text/plain", "Motor ligado");
}

void comandoDesligar() {
  desligarMotor();

  servidor.send(
    200,
    "text/plain",
    "Motor desligado"
  );
}

// =====================================
// SENSOR ULTRASSONICO
// =====================================
float medirDistancia() {
  digitalWrite(TRIG, LOW);
  delayMicroseconds(3);

  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG, LOW);

  unsigned long tempo =
    pulseIn(ECHO, HIGH, 25000UL);

  if (tempo == 0) {
    return -1;
  }

  float cm = tempo * 0.0343 / 2.0;

  if (cm < 2 || cm > 400) {
    return -1;
  }

  return cm;
}

// =====================================
// CONTADOR DE OBJETOS
// =====================================
void atualizarContador() {
  if (millis() - ultimaLeitura < 100) {
    return;
  }

  ultimaLeitura = millis();

  distancia = medirDistancia();

  // Leitura invalida nao conta
  // e nao libera outro objeto
  if (distancia < 0) {
    leiturasEntrada = 0;
    leiturasSaida = 0;
    return;
  }

  // AGUARDANDO OBJETO SAIR
  if (objetoPresente) {
    leiturasEntrada = 0;

    if (distancia >= LIMITE_SAIDA) {
      leiturasSaida++;

      if (leiturasSaida >= CONFIRMA_SAIDA) {
        objetoPresente = false;
        leiturasSaida = 0;

        Serial.println("Sensor liberado");
      }

    } else {
      leiturasSaida = 0;
    }
  }

  // AGUARDANDO NOVO OBJETO
  else {
    leiturasSaida = 0;

    if (distancia <= LIMITE_ENTRADA) {
      leiturasEntrada++;

      if (leiturasEntrada >= CONFIRMA_ENTRADA) {
        contador++;

        objetoPresente = true;
        leiturasEntrada = 0;

        Serial.print("OBJETO CONTADO: ");
        Serial.println(contador);
      }

    } else {
      leiturasEntrada = 0;
    }
  }
}

// =====================================
// DADOS PARA O PAINEL
// =====================================
void enviarDados() {
  String json = "{";

  json += "\"contador\":";
  json += String(contador);

  json += ",\"distancia\":";
  json += String(distancia, 1);

  json += ",\"motor\":";
  json += (motorLigado ? "true" : "false");

  json += ",\"habilitado\":";
  json += (MOTOR_HABILITADO ? "true" : "false");

  json += ",\"pronto\":";
  json += (!objetoPresente ? "true" : "false");

  json += "}";

  servidor.send(
    200,
    "application/json",
    json
  );
}

// =====================================
// ZERAR CONTADOR
// =====================================
void zerarContador() {
  contador = 0;

  // Aguarda objeto sair antes
  // de permitir nova contagem
  objetoPresente = true;
  leiturasEntrada = 0;
  leiturasSaida = 0;

  servidor.send(200, "text/plain", "OK");
}

